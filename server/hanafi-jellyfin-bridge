#!/usr/bin/env python3
import hashlib
import importlib.machinery
import importlib.util
import json
import mimetypes
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

# v2.5 metadata layer. The accepted v2.4 bridge is kept byte-for-byte in the
# sibling stable module and remains the playback implementation.
CORE_PATH = Path(__file__).with_name('hanafi-jellyfin-bridge-stable.py')
loader = importlib.machinery.SourceFileLoader('hanafi_bridge_stable', str(CORE_PATH))
spec = importlib.util.spec_from_loader(loader.name, loader)
core = importlib.util.module_from_spec(spec)
loader.exec_module(core)

PUBLIC_ROOT = Path(os.path.expanduser(
    os.environ.get('HANAFI_PUBLIC_MEDIA_ROOT', '~/Videos/Hosted')
)).resolve()
POSTER_CACHE = Path(os.path.expanduser(
    os.environ.get('HANAFI_POSTER_CACHE', '~/.cache/hanafi-media/posters')
))
LIBRARY_REFRESH_COOLDOWN = float(
    os.environ.get('HANAFI_LIBRARY_REFRESH_COOLDOWN', '300')
)
VIDEO_EXTS = {
    '.mp4', '.m4v', '.webm', '.ogv', '.ogg', '.ogx', '.mov', '.mkv',
    '.avi', '.ts', '.m2ts', '.mpeg', '.mpg', '.wmv', '.flv', '.3gp', '.vob'
}

def path_in_public_root(path):
    try:
        Path(path).resolve().relative_to(PUBLIC_ROOT)
        return True
    except (OSError, ValueError):
        return False

def title_year_from_path(path):
    p = Path(path)
    candidate = p.parent.name if p.parent.resolve() != PUBLIC_ROOT else p.stem
    candidate = candidate.replace('_', ' ').replace('.', ' ')
    match = re.search(r'^(.*?)\s*\(((?:18|19|20)\d{2})\)\s*$', candidate)
    if match:
        return re.sub(r'\s+', ' ', match.group(1)).strip(), int(match.group(2))
    cleaned = re.sub(
        r'\b(?:480p|720p|1080p|2160p|bluray|brrip|webrip|web-dl|hevc|x264|x265|h264|h265)\b.*$',
        '', candidate, flags=re.I
    )
    return re.sub(r'\s+', ' ', cleaned).strip(' -.') or p.stem, None

def media_content_type(path, configured=''):
    if configured:
        return configured
    extension = Path(path).suffix.lower()
    return {
        '.mp4': 'video/mp4',
        '.m4v': 'video/mp4',
        '.webm': 'video/webm',
        '.ogv': 'video/ogg',
        '.ogg': 'video/ogg',
        '.ogx': 'video/ogg',
        '.mov': 'video/quicktime',
        '.mkv': 'video/x-matroska',
        '.avi': 'video/x-msvideo',
        '.ts': 'video/mp2t',
        '.m2ts': 'video/mp2t',
        '.mpeg': 'video/mpeg',
        '.mpg': 'video/mpeg',
    }.get(extension, mimetypes.guess_type(path)[0] or 'application/octet-stream')

def public_slug(text):
    value = re.sub(r'[^a-z0-9]+', '-', str(text).lower()).strip('-')
    return value or 'movie'

def automatic_media_id(path):
    try:
        rel = str(Path(path).resolve().relative_to(PUBLIC_ROOT))
    except (OSError, ValueError):
        rel = str(path)
    title, year = title_year_from_path(path)
    digest = hashlib.sha256(rel.encode('utf-8')).hexdigest()[:10]
    stem = public_slug(f"{title}-{year or ''}")
    return f"auto-{stem}-{digest}"

def scan_public_files(explicit_folders):
    groups = {}
    if not PUBLIC_ROOT.is_dir():
        return {}
    for path in PUBLIC_ROOT.rglob('*'):
        if not path.is_file() or path.suffix.lower() not in VIDEO_EXTS:
            continue
        try:
            resolved = path.resolve()
            rel = resolved.relative_to(PUBLIC_ROOT)
        except (OSError, ValueError):
            continue
        if resolved.parent in explicit_folders:
            continue
        group = rel.parts[0] if len(rel.parts) > 1 else str(rel)
        groups.setdefault(group, []).append(resolved)

    result = {}
    for candidates in groups.values():
        def size(candidate):
            try:
                return candidate.stat().st_size
            except OSError:
                return -1
        path = max(candidates, key=size)
        media_id = automatic_media_id(path)
        result[media_id] = {
            'id': media_id,
            'path': str(path),
            'content_type': media_content_type(str(path)),
            'subtitle_path': '',
            'jellyfin': None,
            'automatic': True,
        }
    return result

def local_poster_path(item):
    path = Path(item.get('path') or '')
    folder = path.parent
    if not folder.is_dir():
        return None
    stems = ('poster', 'folder', 'cover', folder.name, path.stem)
    for stem in stems:
        for extension in ('.jpg', '.jpeg', '.png', '.webp'):
            candidate = folder / f'{stem}{extension}'
            if candidate.is_file():
                return candidate
    return None

def generated_poster_path(item):
    path = item.get('path') or ''
    try:
        stat = os.stat(path)
    except OSError:
        return None
    key = hashlib.sha256(
        f'{path}|{stat.st_size}|{stat.st_mtime_ns}'.encode('utf-8')
    ).hexdigest()
    return POSTER_CACHE / f'{key}.jpg'

def ensure_generated_poster(item):
    cached = generated_poster_path(item)
    if cached is None:
        return None
    if cached.is_file() and cached.stat().st_size > 0:
        return cached
    if not os.path.isfile(core.FFMPEG) or not os.access(core.FFMPEG, os.X_OK):
        return None
    POSTER_CACHE.mkdir(parents=True, exist_ok=True)
    temp = cached.with_suffix('.tmp.jpg')
    for seek in ('20', '1'):
        command = [
            core.FFMPEG, '-nostdin', '-hide_banner', '-loglevel', 'error',
            '-ss', seek, '-i', item['path'], '-frames:v', '1',
            '-vf', 'scale=700:-2', '-q:v', '3', '-y', str(temp),
        ]
        try:
            process = subprocess.run(
                command,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=45,
                check=False,
            )
        except (OSError, subprocess.SubprocessError):
            process = None
        if (
            process
            and process.returncode == 0
            and temp.is_file()
            and temp.stat().st_size > 0
        ):
            temp.replace(cached)
            return cached
        try:
            temp.unlink()
        except OSError:
            pass
    return None

class MetadataState(core.State):
    def __init__(self):
        super().__init__()
        for value in self.items.values():
            value['automatic'] = False
        self.discovered = {}
        self.last_library_refresh = 0.0

    def request_library_refresh(self):
        now = time.monotonic()
        with self.lock:
            if now - self.last_library_refresh < LIBRARY_REFRESH_COOLDOWN:
                return False
            self.last_library_refresh = now
        token = core.jellyfin_token()
        if not token:
            return False
        request = urllib.request.Request(
            core.JELLYFIN_URL + '/Library/Refresh',
            method='POST',
            headers={'X-Emby-Token': token, 'Accept': 'application/json'},
        )
        try:
            with urllib.request.urlopen(request, timeout=20) as response:
                response.read(1)
            return True
        except Exception:
            return False

    def refresh(self, trigger_library=False):
        if trigger_library:
            self.request_library_refresh()
        query = urllib.parse.urlencode({
            'Recursive': 'true',
            'Fields': (
                'Path,MediaSources,ProviderIds,Overview,RunTimeTicks,'
                'ProductionYear,OriginalTitle,ImageTags'
            ),
            'IncludeItemTypes': 'Movie,Video',
            'Limit': '10000',
        })
        try:
            payload = self.request_json('/Items?' + query)
        except Exception:
            payload = {'Items': []}

        by_path = {}
        for item in payload.get('Items', []):
            path = item.get('Path')
            if path:
                by_path[os.path.normcase(os.path.normpath(path))] = item

        indexed = 0
        explicit_paths = set()
        explicit_folders = set()
        with self.lock:
            for entry in self.items.values():
                norm = os.path.normcase(os.path.normpath(entry['path']))
                explicit_paths.add(norm)
                try:
                    explicit_folders.add(Path(entry['path']).parent.resolve())
                except OSError:
                    pass
                match = by_path.get(norm)
                entry['jellyfin'] = match
                if match:
                    indexed += 1

        discovered = scan_public_files(explicit_folders)
        discovered_by_path = {
            os.path.normcase(os.path.normpath(value['path'])): value
            for value in discovered.values()
        }

        for norm, jellyfin_item in by_path.items():
            path = jellyfin_item.get('Path') or ''
            if norm in explicit_paths or not path_in_public_root(path):
                continue
            existing = discovered_by_path.get(norm)
            if existing:
                existing['jellyfin'] = jellyfin_item
                continue
            media_id = automatic_media_id(path)
            discovered[media_id] = {
                'id': media_id,
                'path': path,
                'content_type': media_content_type(path),
                'subtitle_path': '',
                'jellyfin': jellyfin_item,
                'automatic': True,
            }

        with self.lock:
            self.discovered = discovered
        return indexed

    def get(self, media_id):
        with self.lock:
            item = self.items.get(media_id) or self.discovered.get(media_id)
            return dict(item) if item else None

    def values(self):
        with self.lock:
            return (
                [dict(value) for value in self.items.values()]
                + [dict(value) for value in self.discovered.values()]
            )

    def catalog_record(self, value):
        jellyfin_item = value.get('jellyfin') or {}
        fallback_title, fallback_year = title_year_from_path(
            value.get('path') or ''
        )
        title = (jellyfin_item.get('Name') or fallback_title or 'Movie').strip()
        year = jellyfin_item.get('ProductionYear') or fallback_year
        runtime_ticks = jellyfin_item.get('RunTimeTicks') or 0
        try:
            runtime_seconds = int(runtime_ticks) // 10_000_000
        except (TypeError, ValueError):
            runtime_seconds = 0
        provider_ids = jellyfin_item.get('ProviderIds') or {}
        image_tags = jellyfin_item.get('ImageTags') or {}
        local_ready = os.path.isfile(value.get('path') or '')
        poster = bool(
            local_poster_path(value)
            or image_tags.get('Primary')
            or (
                local_ready
                and os.path.isfile(core.FFMPEG)
                and os.access(core.FFMPEG, os.X_OK)
            )
        )
        return {
            'id': value['id'],
            'type': media_content_type(
                value.get('path') or '', value.get('content_type', '')
            ),
            'subtitles': bool(value.get('subtitle_path')),
            'ready': local_ready or bool(jellyfin_item),
            'local': local_ready,
            'jellyfinIndexed': bool(jellyfin_item),
            'automatic': bool(value.get('automatic')),
            'title': title,
            'originalTitle': jellyfin_item.get('OriginalTitle') or '',
            'year': year,
            'overview': jellyfin_item.get('Overview') or '',
            'runtimeSeconds': runtime_seconds,
            'providerIds': provider_ids,
            'poster': poster,
        }

    def all_public(self):
        return [self.catalog_record(value) for value in self.values()]

STATE = MetadataState()
core.STATE = STATE

class MetadataHandler(core.Handler):
    def handle_request(self, head=False):
        parsed = urllib.parse.urlsplit(self.path)
        params = urllib.parse.parse_qs(parsed.query)
        media_id = params.get('id', [''])[0]

        if parsed.path == '/nougat/v1/catalog':
            STATE.refresh(trigger_library=True)
            self.json_response(200, {
                'ok': True,
                'service': 'Nougat extracted media server',
                'items': STATE.all_public(),
            }, head)
            return

        if parsed.path == '/nougat/v1/poster':
            self.stream_poster(media_id, head)
            return

        super().handle_request(head)

    def stream_poster(self, media_id, head):
        item = STATE.get(media_id)
        if not item:
            STATE.refresh()
            item = STATE.get(media_id)
        if not item:
            self.json_response(
                404, {'ok': False, 'error': 'Unknown media id.'}, head
            )
            return

        local = local_poster_path(item)
        if local:
            self.stream_image_file(local, head)
            return

        jellyfin_item = item.get('jellyfin') or {}
        item_id = jellyfin_item.get('Id')
        token = core.jellyfin_token()
        has_primary = bool(
            (jellyfin_item.get('ImageTags') or {}).get('Primary')
        )

        if token and item_id and has_primary:
            target = (
                f"{core.JELLYFIN_URL}/Items/"
                f"{urllib.parse.quote(str(item_id))}/Images/Primary"
                f"?maxWidth=700&quality=90"
            )
            request = urllib.request.Request(
                target,
                method='HEAD' if head else 'GET',
                headers={'Accept': 'image/*', 'X-Emby-Token': token},
            )
            try:
                upstream = urllib.request.urlopen(request, timeout=30)
            except urllib.error.HTTPError as exc:
                upstream = exc
            except Exception:
                upstream = None

            if upstream is not None:
                try:
                    if 200 <= upstream.status < 300:
                        self.send_response(upstream.status)
                        self.send_header(
                            'Content-Type',
                            upstream.headers.get('Content-Type') or 'image/jpeg'
                        )
                        length = upstream.headers.get('Content-Length')
                        if length:
                            self.send_header('Content-Length', length)
                        for name in ('ETag', 'Last-Modified'):
                            value = upstream.headers.get(name)
                            if value:
                                self.send_header(name, value)
                        self.send_header(
                            'Cache-Control', 'public, max-age=86400'
                        )
                        self.send_header('X-Content-Type-Options', 'nosniff')
                        self.send_header('Connection', 'close')
                        self.cors()
                        self.end_headers()
                        if not head:
                            while True:
                                chunk = upstream.read(128 * 1024)
                                if not chunk:
                                    break
                                self.wfile.write(chunk)
                        self.close_connection = True
                        return
                except (BrokenPipeError, ConnectionResetError, OSError):
                    self.close_connection = True
                    return
                finally:
                    upstream.close()

        generated = ensure_generated_poster(item)
        if generated:
            self.stream_image_file(generated, head)
            return

        self.json_response(
            404, {'ok': False, 'error': 'No poster is available for this item.'},
            head
        )

    def stream_image_file(self, path, head):
        try:
            size = path.stat().st_size
        except OSError:
            self.json_response(
                404, {'ok': False, 'error': 'Poster file is unavailable.'}, head
            )
            return
        self.send_response(200)
        self.send_header(
            'Content-Type',
            mimetypes.guess_type(str(path))[0] or 'image/jpeg'
        )
        self.send_header('Content-Length', str(size))
        self.send_header('Cache-Control', 'public, max-age=86400')
        self.send_header('X-Content-Type-Options', 'nosniff')
        self.send_header('Connection', 'close')
        self.cors()
        self.end_headers()
        if not head:
            try:
                with open(path, 'rb') as handle:
                    while True:
                        chunk = handle.read(128 * 1024)
                        if not chunk:
                            break
                        self.wfile.write(chunk)
            except (OSError, BrokenPipeError, ConnectionResetError):
                pass
        self.close_connection = True

def main():
    STATE.request_library_refresh()
    indexed = STATE.refresh()
    items = STATE.all_public()
    available = sum(1 for item in items if item['ready'])
    print(
        f'Hanafi/Nougat media bridge ready: {available}/{len(items)} files '
        f'available, {indexed} manifest files currently indexed by Jellyfin.',
        flush=True,
    )
    server = core.ThreadingHTTPServer((core.BIND, core.PORT), MetadataHandler)
    print(
        f'Hanafi media bridge listening on http://{core.BIND}:{core.PORT}',
        flush=True,
    )
    server.serve_forever()

if __name__ == '__main__':
    main()
